<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kangra Fort Map</title>
    <style>
        /* This centers the map perfectly on your screen */
        body {
            margin: 0;
            padding: 20px;
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* This wrapper acts as the anchor for our interactive dots */
        .map-container {
            position: relative;
            max-width: 900px;
            width: 100%;
        }

        /* This ensures the image scales beautifully on phones and desktops */
        .map-image {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        }
    </style>
</head>
<body>

    <div class="map-container">
        <!-- Replace 'kangra-fort.jpg' with your actual image filename later -->
        <img src="kangra-fort.jpg" alt="Kangra Fort Model" class="map-image">
    </div>

</body>
</html>
