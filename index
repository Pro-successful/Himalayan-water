<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kangra Fort Map</title>
    <style>
        body {
            margin: 0;
            padding: 20px;
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .map-container {
            position: relative;
            max-width: 900px;
            width: 100%;
        }

        .map-image {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        }

        /* NEW STYLES FOR STEP 2: The Interactive Hotspots */
        .hotspot {
            position: absolute;
            width: 40px;
            height: 40px;
            background-color: rgba(0, 188, 212, 0.7); /* Cyan color matching your image */
            border: 3px solid #ffffff;
            border-radius: 50%;
            cursor: pointer;
            transform: translate(-50%, -50%); /* Centers the dot exactly on its coordinates */
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: transform 0.2s ease;
        }

        /* Make the marker pop slightly when you hover over it */
        .hotspot:hover {
            transform: translate(-50%, -50%) scale(1.2);
            background-color: rgba(0, 188, 212, 1);
        }

        /* Position Marker 1: Near the Ticket Counter area */
        .marker-ticket {
            top: 53%;
            left: 75%;
        }

        /* Position Marker 2: Near the Inner Courtyard area */
        .marker-courtyard {
            top: 24%;
            left: 76%;
        }
    </style>
</head>
<body>

    <div class="map-container">
        <img src="kangra-fort.jpg" alt="Kangra Fort Model" class="map-image">
        
        <!-- NEW CODE: Adding our two interactive hotspot buttons -->
        <div class="hotspot marker-ticket"></div>
        <div class="hotspot marker-courtyard"></div>
    </div>

</body>
</html>
